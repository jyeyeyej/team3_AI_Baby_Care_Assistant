APP_ENV=development
APP_TIMEZONE=Asia/Seoul
TEST_MODE=true

# Streamlit → FastAPI
BACKEND_API_URL=http://localhost:8000
# 백엔드 개발 전에는 true로 유지합니다. 준비 후 false로 바꾸면 실제 FastAPI를 호출합니다.
USE_MOCK_API=true
BACKEND_API_TIMEOUT_SECONDS=10

# PostgreSQL·Redis
POSTGRES_DSN=postgresql+psycopg://postgres:password@localhost:5432/baby_ai
REDIS_URL=redis://localhost:6380/0

# OpenAI Responses API·STT
OPENAI_API_KEY=
OPENAI_MODEL=
# baby_info_server가 RAG 근거를 바탕으로 답변을 생성할 때 사용하는 모델
OPENAI_RESPONSE_MODEL=gpt-4.1-mini
OPENAI_VISION_MODEL=
STT_MODEL=gpt-4o-mini-transcribe

# MCP 서버: Backend/DB/Redis 서버와 분리 배포할 수 있습니다.
# 운영에서는 localhost 대신 각 MCP 서버의 내부 DNS 또는 고정 주소를 지정합니다.
# 예: BABY_CARE_MCP_URL=http://baby-care-mcp:8101/mcp
# 예: BABY_INFO_MCP_URL=http://baby-info-mcp:8102/mcp
BABY_CARE_MCP_URL=http://localhost:8101/mcp
BABY_INFO_MCP_URL=http://localhost:8102/mcp
# 로컬 직접 실행 기준입니다. Docker 컨테이너에서는 MCP_HOST=0.0.0.0으로 설정합니다.
MCP_HOST=127.0.0.1
MCP_PORT=8102
MCP_STREAMABLE_HTTP_PATH=/mcp

# Ollama Embedding
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_EMBEDDING_DIMENSION=768
OLLAMA_TIMEOUT_SECONDS=30
RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.70
RAG_MAX_CONTEXT_CHARS=8000

# 병원 공공데이터
# baby_info_server가 사용하는 공통 공공데이터 연결값입니다.
PUBLIC_DATA_API_KEY=
PUBLIC_DATA_BASE_URL=
PEDIATRIC_API_KEY=
EMERGENCY_API_KEY=
PEDIATRIC_API_URL=
EMERGENCY_API_URL=
EXTERNAL_API_TIMEOUT_SECONDS=5
EXTERNAL_API_RETRY_COUNT=1

# 업로드 제한
MAX_IMAGE_SIZE_MB=10
MAX_AUDIO_SIZE_MB=20
IMAGE_TEMP_DIRECTORY=uploads
IMAGE_MAX_BYTES=10485760
IMAGE_MIN_WIDTH=224
IMAGE_MIN_HEIGHT=224
IMAGE_DARK_THRESHOLD=35
IMAGE_BRIGHT_THRESHOLD=235
IMAGE_BLUR_THRESHOLD=20
